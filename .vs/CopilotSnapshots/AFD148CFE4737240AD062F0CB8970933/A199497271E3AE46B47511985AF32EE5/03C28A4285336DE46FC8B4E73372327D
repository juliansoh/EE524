bool load_image_bytes_flattened(const char* imagePath, float* flattenedOut, int pixelCount)
{
    FILE* imageFile = fopen(imagePath, "rb");
    if (imageFile == nullptr) {
        fprintf(stderr, "[ERROR] Failed to open %s\n", imagePath);
        return false;
    }

    unsigned char* imageBytes = new (std::nothrow) unsigned char[pixelCount];
    if (imageBytes == nullptr) {
        fprintf(stderr, "[ERROR] Failed to allocate image byte buffer.\n");
        fclose(imageFile);
        return false;
    }

    size_t bytesRead = fread(imageBytes, 1, pixelCount, imageFile);
    fclose(imageFile);
    if (bytesRead == 0) {
        fprintf(stderr, "[ERROR] Failed to read %s\n", imagePath);
        delete[] imageBytes;
        return false;
    }

    for (int p = 0; p < pixelCount; ++p) {
        flattenedOut[p] = static_cast<float>(imageBytes[p % bytesRead]);
    }

    delete[] imageBytes;
    return true;
}

cudaError_t single_branch_run(float* in, float* out, int n)
{
	float* in_d = nullptr;
	float* out_d = nullptr;
    cudaError_t cudaStatus = cudaSuccess;

    // Part 1: Allocate device memory and copy from host memory to device memory
    cudaStatus = checkCuda(cudaMalloc((void**)&in_d, n * sizeof(float)), "cudaMalloc in_d");
    if (cudaStatus != cudaSuccess) return cudaStatus;
    cudaStatus = checkCuda(cudaMalloc((void**)&out_d, n * sizeof(float)), "cudaMalloc out_d");
    if (cudaStatus != cudaSuccess) {
        cudaFree(in_d);
        return cudaStatus;
    }
    cudaStatus = checkCuda(cudaMemcpy(in_d, in, n * sizeof(float), cudaMemcpyHostToDevice), "cudaMemcpy H2D in");
    if (cudaStatus != cudaSuccess) {
        cudaFree(in_d);
        cudaFree(out_d);
        return cudaStatus;
    }

    // Part 2: Call kernel - to launch a grid of threads to perform 2D operation
	int threadsPerBlock = 256;
	int blocksPerGrid = (n + threadsPerBlock - 1) / threadsPerBlock;
	single_branch_kernel<<<blocksPerGrid, threadsPerBlock>>>(in_d, out_d, n);
    cudaStatus = checkCuda(cudaGetLastError(), "single_branch_kernel launch");
    if (cudaStatus != cudaSuccess) {
        cudaFree(in_d);
        cudaFree(out_d);
        return cudaStatus;
    }
    cudaStatus = checkCuda(cudaDeviceSynchronize(), "cudaDeviceSynchronize single_branch_kernel");
    if (cudaStatus != cudaSuccess) {
        cudaFree(in_d);
        cudaFree(out_d);
        return cudaStatus;
    }

    // Part 3: Copy from device memory to host memory
    cudaStatus = checkCuda(cudaMemcpy(out, out_d, n * sizeof(float), cudaMemcpyDeviceToHost), "cudaMemcpy D2H out");
    if (cudaStatus != cudaSuccess) {
        cudaFree(in_d);
        cudaFree(out_d);
        return cudaStatus;
    }

    // Part 4: Free device memory
	cudaFree(in_d);
	cudaFree(out_d);

    return cudaSuccess;
}

cudaError_t nested_branch_run(float* in, float* out, int width, int height)
{
	float* in_d = nullptr;
	float* out_d = nullptr;
	cudaError_t cudaStatus = cudaSuccess;
	// Part 1: Allocate device memory and copy from host memory to device memory
	cudaStatus = checkCuda(cudaMalloc((void**)&in_d, width * height * sizeof(float)), "cudaMalloc in_d");
	if (cudaStatus != cudaSuccess) return cudaStatus;
	cudaStatus = checkCuda(cudaMalloc((void**)&out_d, width * height * sizeof(float)), "cudaMalloc out_d");
	if (cudaStatus != cudaSuccess) {
		cudaFree(in_d);
		return cudaStatus;
	}
	cudaStatus = checkCuda(cudaMemcpy(in_d, in, width * height * sizeof(float), cudaMemcpyHostToDevice), "cudaMemcpy H2D in");
	if (cudaStatus != cudaSuccess) {
		cudaFree(in_d);
		cudaFree(out_d);
		return cudaStatus;
	}
	// Part 2: Call kernel - to launch a grid of threads to perform 2D operation
	dim3 threadsPerBlock(16, 16);
	dim3 blocksPerGrid((width + threadsPerBlock.x - 1) / threadsPerBlock.x,
		(height + threadsPerBlock.y - 1) / threadsPerBlock.y);
	nested_branch_kernel << <blocksPerGrid, threadsPerBlock >> > (in_d, out_d, width, height);
	cudaStatus = checkCuda(cudaGetLastError(), "nested_branch_kernel launch");
	if (cudaStatus != cudaSuccess) {
		cudaFree(in_d);
		cudaFree(out_d);
		return cudaStatus;
	}
	cudaStatus = checkCuda(cudaDeviceSynchronize(), "cudaDeviceSynchronize nested_branch_kernel");
	if (cudaStatus != cudaSuccess) {
		cudaFree(in_d);
		cudaFree(out_d);
		return cudaStatus;
	}
	// Part 3: Copy from device memory to host memory
	cudaStatus = checkCuda(cudaMemcpy(out, out_d, width * height * sizeof(float), cudaMemcpyDeviceToHost), "cudaMemcpy D2H out");
	if (cudaStatus != cudaSuccess) {
		cudaFree(in_d);
		cudaFree(out_d);
		return cudaStatus;
	}
	// Part 4: Free device memory
	cudaFree(in_d);
	cudaFree(out_d);

	return cudaSuccess;
}
