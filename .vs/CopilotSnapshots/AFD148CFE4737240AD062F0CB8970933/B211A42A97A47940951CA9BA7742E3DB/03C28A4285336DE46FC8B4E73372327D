{
	// Compute Vector Analysis with Single Branching
	// Each thread computes one element of the output vector.

	// To create the thread diversion, we will use the 
    // thread index to determine which element of the input vector to process. 
    // Each thread will check if the corresponding input value is greater than 100.0f 
    // and apply different operations based on that condition.

    int i = threadIdx.x + blockDim.x * blockIdx.x;
    if (i < n) {
        if (in[i] > 100.0f) {
            out[i] = in[i];
        }
        else {
            out[i] = in[i] * 2.0f;
        }
    }
}
