#include "device_launch_parameters.h"

#include <stdio.h>
#include "Error-Checking.h"
#include <math.h>
#include <stdlib.h>
#include <cuda_runtime.h>
#include <cstdint>

// divergence_demo.cu

__global__ void single_branch_kernel(const float* in, float* out, int n) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= n) return;

    int lane = threadIdx.x & 31;  // 0..31 within each warp

    // Case 1: single branch (2 control paths per warp)
    if (lane < 16) {
        out[idx] = in[idx] + 1.0f;   // GMEM write in branch A
    }
    else {
        out[idx] = in[idx] - 1.0f;   // GMEM write in branch B
    }
}

__global__ void nested_branch_kernel(const float* in, float* out, int n) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= n) return;

    int lane = threadIdx.x & 31;

    // Case 2: nested branch (3+ control paths per warp)
    if (lane < 8) {
        out[idx] = in[idx] + 10.0f;  // path 1
    }
    else {
        if (lane < 16) {
            out[idx] = in[idx] + 20.0f;  // path 2
        }
        else if (lane < 24) {
            out[idx] = in[idx] + 30.0f;  // path 3
        }
        else {
            out[idx] = in[idx] + 40.0f;  // path 4
        }
    }
}


int main()
{
    const int n = 256;
    const size_t bytes = n * sizeof(float);

    float* in_h = (float*)malloc(bytes);
    float* out_h = (float*)malloc(bytes);
    if (in_h == nullptr || out_h == nullptr) {
        fprintf(stderr, "Host malloc failed!\n");
        free(in_h);
        free(out_h);
        return 1;
    }

    for (int i = 0; i < n; i++) {
        in_h[i] = (float)i;
    }

    float* in_d = nullptr;
    float* out_d = nullptr;

    cudaError_t cudaStatus = cudaSetDevice(0);
    if (cudaStatus != cudaSuccess) {
        fprintf(stderr, "cudaSetDevice failed!\n");
        free(in_h);
        free(out_h);
        return 1;
    }

    cudaStatus = cudaMalloc((void**)&in_d, bytes);
    if (cudaStatus != cudaSuccess) {
        fprintf(stderr, "cudaMalloc in_d failed!\n");
        free(in_h);
        free(out_h);
        return 1;
    }

    cudaStatus = cudaMalloc((void**)&out_d, bytes);
    if (cudaStatus != cudaSuccess) {
        fprintf(stderr, "cudaMalloc out_d failed!\n");
        cudaFree(in_d);
        free(in_h);
        free(out_h);
        return 1;
    }

    cudaStatus = cudaMemcpy(in_d, in_h, bytes, cudaMemcpyHostToDevice);
    if (cudaStatus != cudaSuccess) {
        fprintf(stderr, "cudaMemcpy H2D failed!\n");
        cudaFree(in_d);
        cudaFree(out_d);
        free(in_h);
        free(out_h);
        return 1;
    }

    const int blockSize = 128;
    const int gridSize = (n + blockSize - 1) / blockSize;
    single_branch_kernel<<<gridSize, blockSize>>>(in_d, out_d, n);

    cudaStatus = cudaGetLastError();
    if (cudaStatus != cudaSuccess) {
        fprintf(stderr, "single_branch_kernel launch failed: %s\n", cudaGetErrorString(cudaStatus));
        cudaFree(in_d);
        cudaFree(out_d);
        free(in_h);
        free(out_h);
        return 1;
    }

    cudaStatus = cudaDeviceSynchronize();
    if (cudaStatus != cudaSuccess) {
        fprintf(stderr, "cudaDeviceSynchronize failed: %s\n", cudaGetErrorString(cudaStatus));
        cudaFree(in_d);
        cudaFree(out_d);
        free(in_h);
        free(out_h);
        return 1;
    }

    cudaStatus = cudaMemcpy(out_h, out_d, bytes, cudaMemcpyDeviceToHost);
    if (cudaStatus != cudaSuccess) {
        fprintf(stderr, "cudaMemcpy D2H failed!\n");
        cudaFree(in_d);
        cudaFree(out_d);
        free(in_h);
        free(out_h);
        return 1;
    }

    for (int i = 0; i < 8; i++) {
        printf("out_h[%d] = %.1f\n", i, out_h[i]);
    }

    cudaFree(in_d);
    cudaFree(out_d);
    free(in_h);
    free(out_h);
    cudaDeviceReset();

    return 0;
}

