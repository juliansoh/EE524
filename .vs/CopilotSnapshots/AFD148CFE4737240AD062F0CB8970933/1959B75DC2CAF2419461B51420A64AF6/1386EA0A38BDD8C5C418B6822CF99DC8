__global__ void single_branch_kernel(const float* in, float* out, int n)
{
	// Compute Vector Analysis with Single Branching
	// Each thread computes one element of the output vector.

    // To force warp divergence, branch on lane id inside each warp.
    // Lanes 0-15 take one path, lanes 16-31 take the other.
	// Initially, we used just the value of the input vector (e.g. if it is >100 .0f) to branch, 
    // but this can lead to all threads in a warp taking the same path, which is not what we want for this exercise.
	// Not sure why but thinking it is because of optimization in the compiler. So we will use the lane id to branch instead.

    int i = threadIdx.x + blockDim.x * blockIdx.x;
    if (i < n) {
        int lane = threadIdx.x & 31;
        if (lane < 16) {
            out[i] = in[i] * 2.0f;
        }
        else {
            out[i] = in[i] * 0.5f;
        }
    }
}
__global__ void nested_branch_kernel(const float* in, float* out, int width, int height)
{
	// Compute Vector Analysis with Nested Branching
	// The use case is to get an input of an image (512x512) and change shades of blue to red based on the pixel value,
	// shades of red to blue based on the pixel value, and other colors to grayscale based on the pixel value. 
	// Once inside a branch for a color/grayscale, we will branch again on intensity to change the brightness of the color/grayscale.
    // The input is a 2D array of pixels, and the output is a 2D array of pixels.
    // using a 16x16 tile.

    int x = blockIdx.x * blockDim.x + threadIdx.x;
    int y = blockIdx.y * blockDim.y + threadIdx.y;

    if (x >= width || y >= height) {
        return;
    }

    int idx = y * width + x;
    int base = idx * 3;

    float r = in[base + 0];
    float g = in[base + 1];
    float b = in[base + 2];
    int lane = threadIdx.x & 31;

    float outR = r;
    float outG = g;
    float outB = b;

    // Nested branching with color-aware transforms:
    // 1) Blue-dominant pixels -> shift toward red
    // 2) Red-dominant pixels  -> shift toward blue
    // 3) Other pixels         -> grayscale
    if (b > r && b > g) {
        if (lane < 10) {
            outR = b + 30.0f;
        }
        else if (lane < 21) {
            outR = b + 60.0f;
        }
        else {
            outR = b + 10.0f;
        }
        outG = g * 0.4f;
        outB = b * 0.2f;

#pragma unroll 1
        for (int t = 0; t < 8; ++t) {
            outR = outR * 1.01f + 0.2f;
            outB = outB * 0.99f;
        }
    }
    else if (r > g && r > b) {
        if (lane < 10) {
            outB = r + 30.0f;
        }
        else if (lane < 21) {
            outB = r + 60.0f;
        }
        else {
            outB = r + 10.0f;
        }
        outG = g * 0.4f;
        outR = r * 0.2f;

#pragma unroll 1
        for (int t = 0; t < 8; ++t) {
            outB = outB * 1.01f + 0.2f;
            outR = outR * 0.99f;
        }
    }
    else {
        float gray = 0.299f * r + 0.587f * g + 0.114f * b;
        if (lane < 10) {
            gray = gray * 1.15f;
        }
        else if (lane < 21) {
            gray = gray * 0.85f;
        }
        else {
            gray = gray + 12.0f;
        }
        outR = gray;
        outG = gray;
        outB = gray;

#pragma unroll 1
        for (int t = 0; t < 8; ++t) {
            outR = outR + 0.1f * sinf(outR * 0.01f);
            outG = outR;
            outB = outR;
        }
    }

    outR = fminf(255.0f, fmaxf(0.0f, outR));
    outG = fminf(255.0f, fmaxf(0.0f, outG));
    outB = fminf(255.0f, fmaxf(0.0f, outB));

    out[base + 0] = outR;
    out[base + 1] = outG;
    out[base + 2] = outB;

}

