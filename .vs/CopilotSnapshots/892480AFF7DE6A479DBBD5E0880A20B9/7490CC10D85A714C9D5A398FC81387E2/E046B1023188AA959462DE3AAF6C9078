// Naive square matrix multiplication: one thread computes one element of P = M * N.
// M, N, and P are device pointers to row-major matrices, indexed as row * width + col.
// Each multiply reads its operands from global memory (possibly served by caches).
__global__ void MMULT_GMEM_Kernel(const float* M, const float* N, float* P, int width)
{
    // Map the two-dimensional block and thread coordinates to an output element.
    int row = blockIdx.y * blockDim.y + threadIdx.y;
    int col = blockIdx.x * blockDim.x + threadIdx.x;
    float sum;
	if (row < width && col < width) {
		sum = 0.0f;
		// Take the dot product of row 'row' of M and column 'col' of N.
		for (int k = 0; k < width; ++k)
		{
			sum += M[row * width + k] * N[k * width + col];
		}
	}
	// This write is outside the bounds check; the current launch must have no
	// out-of-range threads, or this uses an uninitialized sum and writes out of bounds.
	P[row * width + col] = sum;
}

// Tiled square matrix multiplication using a pair of per-block shared-memory tiles.
// The current indexing and fixed tile arrays require a 16-by-16 thread block.
__global__ void MMULT_SMEM_Tiled_Kernel
{
	__shared__ float M_tile[16][16];
	__shared__ float N_tile[16][16];
	int row = blockIdx.y * blockDim.y + threadIdx.y;
	int col = blockIdx.x * blockDim.x + threadIdx.x;
	float sum = 0.0f;
	// Each phase covers up to 16 elements of the shared inner dimension.
	for (int tile = 0; tile < (width + 15) / 16; ++tile) {
		// Cooperatively load one element per thread; pad partial edge tiles with zero.
		if (row < width && tile * 16 + threadIdx.x < width) {
			M_tile[threadIdx.y][threadIdx.x] = M[row * width + tile * 16 + threadIdx.x];
		}
		else {
			M_tile[threadIdx.y][threadIdx.x] = 0.0f;
		}
		if (col < width && tile * 16 + threadIdx.y < width) {
			N_tile[threadIdx.y][threadIdx.x] = N[(tile * 16 + threadIdx.y) * width + col];
		}
		else {
			N_tile[threadIdx.y][threadIdx.x] = 0.0f;
		}
		// All tile elements must be loaded before any thread consumes them.
		__syncthreads();
		for (int k = 0; k < 16; ++k) {
			sum += M_tile[threadIdx.y][k] * N_tile[k][threadIdx.x];
		}
		// Finish reading the tiles before any thread overwrites them in the next phase.
		__syncthreads();
	}
	if (row < width && col < width) {
		P[row * width + col] = sum;
	}
}

__global__ void addKernel(int *c, const int *a, const int *b)
{
    int i = threadIdx.x;
    c[i] = a[i] + b[i];
}

int main()
{
	// The vectors own the input data in host RAM; loading does not allocate GPU memory.
	std::vector<float> M_h;
	std::vector<float> N_h;
	if (!load_mmult_inputs(M_h, N_h)) {
		return 1;
	}

	// The matrix kernels are not yet launched; the remaining code is the vector-add example.
	const int arraySize = 5;
    const int a[arraySize] = { 1, 2, 3, 4, 5 };
    const int b[arraySize] = { 10, 20, 30, 40, 50 };
    int c[arraySize] = { 0 };

    // Add vectors in parallel.
    cudaError_t cudaStatus = addWithCuda(c, a, b, arraySize);
    if (cudaStatus != cudaSuccess) {
        fprintf(stderr, "addWithCuda failed!");
        return 1;
    }

    printf("{1,2,3,4,5} + {10,20,30,40,50} = {%d,%d,%d,%d,%d}\n",
        c[0], c[1], c[2], c[3], c[4]);

    // cudaDeviceReset must be called before exiting in order for profiling and
    // tracing tools such as Nsight and Visual Profiler to show complete traces.
    cudaStatus = cudaDeviceReset();
    if (cudaStatus != cudaSuccess) {
        fprintf(stderr, "cudaDeviceReset failed!");
        return 1;
    }

    return 0;
}

